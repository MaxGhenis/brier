{
  "proposed_concept": "usaspending.nist.ai_safety.obligations",
  "status": "rejected",
  "unit": "usd",
  "cadence": "annual",
  "proposedFrom": "frontier-act-hr9925",
  "metricText": "USAspending obligations attributable specifically to NIST AI-safety activity for a complete federal fiscal year.",
  "note": "REJECTED: the complete Commerce federal-account catalog and the tested NIST, ITA, and BIS program-activity catalogs expose no structured AI-safety account or activity. A free-text `AI safety` filter returns one $106,412.26 NIST grant under broad Assistance Listing 11.620, but description matching is not a stable recurring series identity and the full listing is not AI-specific. The only Assistance Listing returned for `artificial intelligence`, 81.012, is awarded by the Department of Energy, not Commerce.",
  "adapterFamily": "usaspending-api",
  "billSlugs": [
    "frontier-act-hr9925"
  ],
  "publisher": "U.S. Department of the Treasury, USAspending",
  "statisticalProduct": "USAspending API v2 federal-account submissions and award transactions tested for a structured NIST AI-safety identity",
  "likelyUrlPattern": "https://api.usaspending.gov/api/v2/search/spending_over_time/",
  "verification": {
    "schemaVersion": "ledger_ingestion_verification_v1",
    "outcome": "rejected",
    "verifiedAtUtc": "2026-08-11T04:28:19Z",
    "reason": "No exact structured USAspending identity isolates NIST, ITA, or BIS AI-safety obligations. The complete FY2025 Commerce account page has 52 rows and no account name containing artificial intelligence, intelligence, AI safety, or AI security. The complete program-activity pages for the closest NIST, BIS, and ITA accounts likewise have no AI-specific row. Assistance Listing autocomplete returns no result for AI safety, machine learning, trustworthy artificial intelligence, or frontier; its one artificial-intelligence result is DOE listing 81.012. The closest NIST award evidence is one FY2025 grant found by free-text description matching under broad listing 11.620. Admitting that keyword result would make an unstable text search the series boundary, while admitting all of 11.620 or a whole NIST account would reverse the required narrow-scoping rule by relabeling a broader total as AI safety.",
    "blocker": "no_exact_structured_ai_program_or_account",
    "scope": {
      "requestedConcept": "Annual obligations attributable specifically to NIST AI-safety work, included only as context for frontier-act-hr9925.",
      "evidenceActuallyProves": [
        "FY2025 Commerce account 013-0500 had 957608896.45 in obligations, but its identity is all NIST Scientific and Technical Research and Services.",
        "A free-text AI safety query returned 106412.26 in FY2025 grant obligations and one award row, 70NANB25H073, under broad Assistance Listing 11.620.",
        "All NIST-awarded FY2025 transactions under Assistance Listing 11.620 totaled 76275845.96, so the listing cannot stand in for the text-matched AI-safety row.",
        "Assistance Listing 81.012 is explicitly AI-named, but its FY2025 awarding-subagency result is Department of Energy with -937.0 in obligations."
      ],
      "rejectedProxies": [
        "all obligations of NIST account 013-0500 or any other NIST account",
        "all NIST-awarded Assistance Listing 11.620 obligations",
        "award-title or award-description keyword matches",
        "Department of Energy Assistance Listing 81.012",
        "all ITA or BIS operations and administration obligations"
      ]
    },
